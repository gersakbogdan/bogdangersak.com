---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
interface Props { title?: string; description?: string; noindex?: boolean }
const {
  title = 'Bogdan Gersak: Engineering notebook',
  description = 'Notes on engineering, AI, leadership, and the things I learn while building software.',
  noindex = false,
} = Astro.props;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f9f9f6" />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a href="/" class="identity" aria-label="Bogdan Gersak home">
          <span class="monogram" aria-hidden="true">bg<span>.</span></span>
          <span class="identity-name">Bogdan Gersak</span>
        </a>
        <span class="header-caption"><span class="status-dot" aria-hidden="true"></span> A public engineering notebook</span>
        <details class="mobile-nav">
          <summary aria-label="Navigation menu"><span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span></summary>
          <Navigation label="Mobile navigation" />
        </details>
      </header>
      <div class="page-grid">
        <aside class="sidebar">
          <Navigation label="Main navigation" class="desktop-nav" />
          <div class="sidebar-note"><span class="tiny-line"></span><p>A place for ideas<br />to become useful.</p></div>
        </aside>
        <main id="main"><slot /></main>
      </div>
      <footer class="site-footer"><span>© {new Date().getFullYear()} Bogdan Gersak</span><span>Always iterating.</span><a href="/about/">About Bogdan <span aria-hidden="true">↗</span></a></footer>
    </div>
  </body>
</html>
