---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import { getEntries, dateLabel, readingTime, topicTitle, sections } from '../../lib/content';
export async function getStaticPaths() {
  return (await getEntries()).map((entry) => {
    const [section, ...segments] = entry.id.split('/');
    return { params: { section, slug: segments.join('/') }, props: { entry } };
  });
}
const { entry } = Astro.props;
const section = sections.find((item) => item.type === entry.data.type)!;
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2);
---
<Base title={entry.data.title + ' — Bogdan Gersak'} description={entry.data.description} noindex={entry.data.status === 'draft'}>
  <article>
    <a class="back-link" href={'/' + section.slug + '/'}>← All {section.title.toLowerCase()}</a>
    <header class="article-heading">
      <div class="entry-meta"><span class={'type-label type-' + entry.data.type}>{entry.data.type}</span><time datetime={entry.data.created.toISOString()}>{dateLabel(entry.data.created)}</time><span>{readingTime(entry)} min read</span></div>
      <h1>{entry.data.title}</h1><p>{entry.data.description}</p>
      <div class="article-topics">{entry.data.topics.map((topic) => <a href={'/topics/' + topic + '/'}>{topicTitle(topic)}</a>)}</div>
    </header>
    {entry.data.status === 'draft' && <p class="preview-notice">Draft · Starter content for review. This page is only available during local development.</p>}
    {toc.length > 1 && <nav class="contents" aria-label="On this page"><p class="eyebrow">ON THIS PAGE</p><ul>{toc.map((heading) => <li><a href={'#' + heading.slug}>{heading.text}</a></li>)}</ul></nav>}
    <div class="prose"><Content /></div>
    <footer class="article-footer">Written in the open. Ideas may evolve.{entry.data.updated && <span> Updated {dateLabel(entry.data.updated)}.</span>}</footer>
    {entry.data.status === 'published' && <Comments />}
  </article>
</Base>
