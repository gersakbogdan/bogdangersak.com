---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { getEntries, isPreview, topics } from '../lib/content';
const entries = await getEntries();
const hasDrafts = entries.some((entry) => entry.data.status === 'draft');
---
<Base>
  <section class="hero">
    <p class="eyebrow"><span class="short-rule"></span> NOTES FROM THE WORK</p>
    <h1>Engineering, leadership,<br class="desktop-break" /> and the work in between<span class="accent">.</span></h1>
    <p class="hero-description">I'm Bogdan, an engineering leader and software builder.<br class="desktop-break" /> This is where I think out loud, connect ideas, and share<br class="desktop-break" /> what I learn along the way.</p>
    <a class="text-link" href="/about/">A little more about me <span aria-hidden="true">↗</span></a>
  </section>

  <section class="latest-section" aria-labelledby="latest-title">
    <div class="section-heading"><h2 id="latest-title">From the notebook</h2><span class="small-caption">IDEAS, IN PROGRESS</span></div>
    {isPreview && hasDrafts && <p class="preview-notice">Local preview · Draft entries appear here for review and are excluded from the production build.</p>}
    <EntryList entries={entries.slice(0, 6)} />
  </section>

  <section class="topics-section" aria-labelledby="topics-title">
    <div class="section-heading"><h2 id="topics-title">Explore by topic</h2></div>
    <div class="topic-grid">{topics.map((topic, i) => (
      <a class="topic-card" href={'/topics/' + topic.slug + '/'}>
        <span class="topic-number">0{i + 1}</span><h3>{topic.title}<span aria-hidden="true">↗</span></h3><p>{topic.description}</p>
      </a>
    ))}</div>
  </section>

  <a class="now-callout" href="/now/"><span class="now-icon" aria-hidden="true">◷</span><span><span class="now-title">What I'm up to now</span><span class="now-description">Learning, building, and the questions on my mind.</span></span><span class="now-arrow" aria-hidden="true">→</span></a>
</Base>
