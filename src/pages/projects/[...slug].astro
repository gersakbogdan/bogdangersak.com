---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import CollectionTabs from '../../components/CollectionTabs.astro';
import { dateLabel, getProjectEntries, getProjectTabs, getProjects } from '../../lib/content';
export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
const entries = await getProjectEntries(project);
const tabs = await getProjectTabs();
const toc = headings.filter((heading) => heading.depth === 2);
---
<Base title={project.data.title + ' | Bogdan Gersak'} description={project.data.description} noindex={project.data.status === 'draft'}>
  <article>
    <CollectionTabs label="Project sections" tabs={tabs} />
    <header class="article-heading">
      <div class="entry-meta"><span class="type-label">{project.data.kind}</span>{project.data.status === 'draft' && <span class="draft-label">Draft</span>}<time datetime={project.data.created.toISOString()}>{dateLabel(project.data.created)}</time></div>
      <h1>{project.data.title}</h1>
      <p>{project.data.description}</p>
      {project.data.website && <p><a class="text-link" href={project.data.website}>Visit the project<span aria-hidden="true">↗</span></a></p>}
    </header>
    {project.data.status === 'draft' && <p class="preview-notice">Draft · Project story for review. This page is only available during local development.</p>}
    {toc.length > 1 && <nav class="contents" aria-label="On this page"><p class="eyebrow">ON THIS PAGE</p><ul>{toc.map((heading) => <li><a href={'#' + heading.slug}>{heading.text}</a></li>)}</ul></nav>}
    <div class="prose"><Content /></div>
    {entries.length > 0 && <section class="project-writing" aria-labelledby="project-writing-title"><div class="section-heading"><h2 id="project-writing-title">From the project notebook</h2></div><EntryList entries={entries} /></section>}
    <footer class="article-footer">A project story, kept alongside the work.{project.data.updated && <span> Updated {dateLabel(project.data.updated)}.</span>}</footer>
  </article>
</Base>
